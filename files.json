    "modifiedAt": "2026-10-30T10:36:20.953Z",
    "content": "#ifndef GRAPH_H\n#define GRAPH_H\n#include \"common.h\"\n#include \"filelist.h\"\n\n/* Undirected graph (adjacency lists) of relationships between files.\n   Nodes are FileRecord ids. Edge types: identical content / same filename. */\ntypedef enum { REL_DUPLICATE, REL_SAMENAME } RelType;\ntypedef struct Edge { int to; RelType type; struct Edge *next; } Edge;\ntypedef struct { int n; size_t edges; Edge **adj; FileRecord **nodes; } Graph;\n\ntypedef void (*GraphVisit)(FileRecord *rec, FileRecord *from, RelType via, int dist, void *ctx);\n\nvoid graph_init(Graph *g, const FileList *l);\nvoid graph_add_edge(Graph *g, int a, int b, RelType t);\nvoid graph_bfs(const Graph *g, int start, GraphVisit fn, void *ctx);\nvoid graph_free(Graph *g);\n#endif\n"
  },
  {
    "id": "fse-project/fse/src/hashtable.c",
    "name": "hashtable.c",
    "path": "fse-project/fse/src/hashtable.c",
    "extension": ".c",
    "isFolder": false,
    "size": 1995,
    "modifiedAt": "2026-10-30T10:36:21.003Z",
    "content": "#include \"hashtable.h\"\n#include <stdlib.h>\n#include <string.h>\n\nstatic uint64_t hash_str(const char *s) {            /* FNV-1a, 64 bit */\n    uint64_t h = 1469598103934665603ULL;\n    while (*s) { h ^= (unsigned char)*s++; h *= 1099511628211ULL; }\n    return h;\n}\nstatic void bucket_append(HNode **b, HNode *n) {\n    n->next = NULL;\n    while (*b) b = &(*b)->next;\n    *b = n;\n}\nvoid ht_init(HashTable *h, size_t cap) {\n    h->cap = cap ? cap : 16; h->count = 0;\n    h->buckets = xcalloc(h->cap, sizeof(HNode *));\n}\nstatic void ht_resize(HashTable *h) {\n    size_t nc = h->cap * 2, i;\n    HNode **nb = xcalloc(nc, sizeof *nb);\n    for (i = 0; i < h->cap; i++) {\n        HNode *n = h->buckets[i];\n        while (n) {\n            HNode *nx = n->next;\n            bucket_append(&nb[hash_str(n->key) % nc], n);\n            n = nx;\n        }\n    }\n    free(h->buckets);\n    h->buckets = nb; h->cap = nc;\n}\nvoid ht_insert(HashTable *h, FileRecord *r) {\n    HNode *n;\n    if (h->count + 1 > h->cap * 3 / 4) ht_resize(h);\n    n = xmalloc(sizeof *n);\n    n->key = r->name; n->rec = r;\n    bucket_append(&h->buckets[hash_str(r->name) % h->cap], n);\n    h->count++;\n}\nvoid ht_lookup(const HashTable *h, const char *name, RecVec *out) {\n    HNode *n;\n    if (!h->buckets) return;\n    for (n = h->buckets[hash_str(name) % h->cap]; n; n = n->next)\n        if (strcmp(n->key, name) == 0) recvec_push(out, n->rec);\n}\nvoid ht_stats(const HashTable *h, size_t *used, size_t *max_chain) {\n    size_t i; *used = 0; *max_chain = 0;\n    for (i = 0; i < h->cap; i++) {\n        size_t len = 0; HNode *n;\n        for (n = h->buckets[i]; n; n = n->next) len++;\n        if (len) (*used)++;\n        if (len > *max_chain) *max_chain = len;\n    }\n}\nvoid ht_free(HashTable *h) {\n    size_t i;\n    if (!h->buckets) return;\n    for (i = 0; i < h->cap; i++) {\n        HNode *n = h->buckets[i];\n        while (n) { HNode *nx = n->next; free(n); n = nx; }\n    }\n    free(h->buckets);\n    h->buckets = NULL; h->cap = h->count = 0;\n}\n"
  },
  {
    "id": "fse-project/fse/src/hashtable.h",
    "name": "hashtable.h",
