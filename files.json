    "modifiedAt": "2026-10-30T10:36:21.312Z",
    "content": "#ifndef TREE_H\n#define TREE_H\n#include \"common.h\"\n#include \"filelist.h\"\n\n/* General tree (first-child / next-sibling) mirroring the folder hierarchy. */\ntypedef struct TreeNode {\n    FileRecord *rec;\n    struct TreeNode *parent, *first_child, *last_child, *next_sibling;\n} TreeNode;\n\n/* Scans `root` breadth-first using a queue, fills `list`, returns the tree. */\nTreeNode *tree_build(const char *root, FileList *list, int *max_depth);\nTreeNode *tree_find(TreeNode *root, const char *rel);\nvoid      tree_print(const TreeNode *n, int max_depth);\nvoid      tree_free(TreeNode *root);\n#endif\n"
  },
  {
    "id": "fse-project/fse/src/trie.c",
    "name": "trie.c",
    "path": "fse-project/fse/src/trie.c",
    "extension": ".c",
    "isFolder": false,
    "size": 1834,
    "modifiedAt": "2026-10-30T10:36:21.351Z",
    "content": "#include \"trie.h\"\n#include <ctype.h>\n#include <stdlib.h>\n\nTrieNode *trie_new(void) { return xcalloc(1, sizeof(TrieNode)); }\n\nstatic TrieNode *child_get(TrieNode *n, unsigned char c, int create) {\n    TrieNode **pp = &n->child;\n    while (*pp && (*pp)->c < c) pp = &(*pp)->sibling;\n    if (*pp && (*pp)->c == c) return *pp;\n    if (!create) return NULL;\n    {\n        TrieNode *nn = xcalloc(1, sizeof *nn);\n        nn->c = c; nn->sibling = *pp; *pp = nn;\n        return nn;\n    }\n}\n\nvoid trie_insert(TrieNode *root, const char *name, FileRecord *rec) {\n    TrieNode *cur = root;\n    for (; *name; name++)\n        cur = child_get(cur, (unsigned char)tolower((unsigned char)*name), 1);\n    {\n        RefNode *r = xmalloc(sizeof *r);\n        r->rec = rec; r->next = cur->refs; cur->refs = r;\n    }\n}\n\nstatic void collect(const TrieNode *n, RecVec *out) {\n    const RefNode *r; const TrieNode *c;\n    for (r = n->refs; r; r = r->next) recvec_push(out, r->rec);\n    for (c = n->child; c; c = c->sibling) collect(c, out);\n}\n\nsize_t trie_prefix(const TrieNode *root, const char *prefix, RecVec *out) {\n    const TrieNode *cur = root;\n    size_t before = out->count;\n    for (; *prefix; prefix++) {\n        cur = child_get((TrieNode *)cur, (unsigned char)tolower((unsigned char)*prefix), 0);\n        if (!cur) return 0;\n    }\n    collect(cur, out);\n    return out->count - before;\n}\n\nsize_t trie_count_nodes(const TrieNode *n) {\n    size_t total = 1; const TrieNode *c;\n    if (!n) return 0;\n    for (c = n->child; c; c = c->sibling) total += trie_count_nodes(c);\n    return total;\n}\n\nvoid trie_free(TrieNode *n) {\n    TrieNode *c;\n    RefNode *r;\n    if (!n) return;\n    c = n->child;\n    while (c) { TrieNode *nx = c->sibling; trie_free(c); c = nx; }\n    r = n->refs;\n    while (r) { RefNode *nx = r->next; free(r); r = nx; }\n    free(n);\n}\n"
  },
  {
    "id": "fse-project/fse/src/trie.h",
    "name": "trie.h",
    "path": "fse-project/fse/src/trie.h",
    "extension": ".h",
    "isFolder": false,
    "size": 731,
    "modifiedAt": "2026-10-30T10:36:21.387Z",
    "content": "#ifndef TRIE_H\n#define TRIE_H\n#include \"common.h\"\n\n/* Case-insensitive trie. Children are a sorted sibling list (compact memory,\n   results come out alphabetically). Search cost is O(len(prefix) + matches). */\ntypedef struct RefNode  { FileRecord *rec; struct RefNode *next; } RefNode;\ntypedef struct TrieNode {\n    unsigned char c;\n    struct TrieNode *child, *sibling;\n    RefNode *refs;                 /* records whose full name ends here */\n} TrieNode;\n\nTrieNode *trie_new(void);\nvoid      trie_insert(TrieNode *root, const char *name, FileRecord *rec);\nsize_t    trie_prefix(const TrieNode *root, const char *prefix, RecVec *out);\nsize_t    trie_count_nodes(const TrieNode *root);\nvoid      trie_free(TrieNode *root);\n#endif\n"
  },
  {
    "id": "fse-project/fse/src/util.c",
    "name": "util.c",
    "path": "fse-project/fse/src/util.c",
    "extension": ".c",
    "isFolder": false,
    "size": 5783,
    "modifiedAt": "2026-10-30T10:36:21.434Z",
    "content": "#include \"common.h\"\n#include <ctype.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <dirent.h>\n#ifdef _WIN32\n#include <windows.h>\n#endif\n\nvoid *xmalloc(size_t n) {\n    void *p = malloc(n ? n : 1);\n    if (!p) { fprintf(stderr, \"fatal: out of memory\\n\"); exit(1); }\n    return p;\n}\nvoid *xcalloc(size_t n, size_t sz) {\n    void *p = calloc(n ? n : 1, sz);\n    if (!p) { fprintf(stderr, \"fatal: out of memory\\n\"); exit(1); }\n    return p;\n}\n\nvoid recvec_init(RecVec *v) { v->items = NULL; v->count = v->cap = 0; }\nvoid recvec_push(RecVec *v, FileRecord *r) {\n    if (v->count == v->cap) {\n        size_t nc = v->cap ? v->cap * 2 : 16;\n        FileRecord **p = realloc(v->items, nc * sizeof *p);\n        if (!p) { fprintf(stderr, \"fatal: out of memory\\n\"); exit(1); }\n        v->items = p; v->cap = nc;\n    }\n    v->items[v->count++] = r;\n}\nvoid recvec_free(RecVec *v) { free(v->items); recvec_init(v); }\n\nvoid human_size(long long b, char *out, size_t n) {\n    static const char *u[] = {\"B\", \"KB\", \"MB\", \"GB\", \"TB\"};\n    double d = (double)b; int i = 0;\n    while (d >= 1024.0 && i < 4) { d /= 1024.0; i++; }\n    if (i == 0) snprintf(out, n, \"%ld B\", (long)b);\n    else        snprintf(out, n, \"%.1f %s\", d, u[i]);\n}\n\nvoid fmt_time(time_t t, char *out, size_t n) {\n    struct tm *tmv = localtime(&t);\n    if (tmv) strftime(out, n, \"%Y-%m-%d %H:%M\", tmv);\n    else snprintf(out, n, \"unknown\");\n}\n\ndouble now_ms(void) {\n#ifdef _WIN32\n    LARGE_INTEGER f, c;\n    QueryPerformanceFrequency(&f);\n    QueryPerformanceCounter(&c);\n    return (double)c.QuadPart * 1000.0 / (double)f.QuadPart;\n#else\n    struct timespec ts;\n    clock_gettime(CLOCK_MONOTONIC, &ts);\n    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;\n#endif\n}\n\nvoid str_lower(char *s) {\n    for (; *s; s++) *s = (char)tolower((unsigned char)*s);\n}\n\n/* Splits `line` in place into words; \"double quoted\" words may contain spaces. */\nint tokenize(char *line, char **argv, int max) {\n    int n = 0;\n    char *p = line;\n    while (*p && n < max) {\n        while (isspace((unsigned char)*p)) p++;\n        if (!*p) break;\n        if (*p == '\"') {\n            p++; argv[n++] = p;\n            while (*p && *p != '\"') p++;\n        } else {\n            argv[n++] = p;\n            while (*p && !isspace((unsigned char)*p)) p++;\n        }\n        if (*p) *p++ = '\\0';\n    }\n    return n;\n}\n\nint path_join(char *out, size_t n, const char *a, const char *b) {\n    int r;\n    if (!a || !*a || strcmp(a, \".\") == 0) r = snprintf(out, n, \"%s\", b);\n    else                                   r = snprintf(out, n, \"%s/%s\", a, b);\n    return (r < 0 || (size_t)r >= n) ? -1 : 0;\n}\n\nvoid full_path(const char *root, const char *rel, char *out) {\n    if (!rel || strcmp(rel, \".\") == 0) snprintf(out, FULL_LEN, \"%s\", root);\n    else                               snprintf(out, FULL_LEN, \"%s/%s\", root, rel);\n}\n\nchar *path_next(char **cur) {\n    char *p = *cur, *tok;\n    if (!p) return NULL;\n    while (*p == '/') p++;\n    if (!*p) { *cur = p; return NULL; }\n    tok = p;\n    while (*p && *p != '/') p++;\n    if (*p) *p++ = '\\0';\n    *cur = p;\n    return tok;\n}\n\n/* Cleans a user path: no absolute paths, no \"..\", collapses \"//\" and \"./\".\n   On Windows it also accepts backslashes and rejects drive letters (\"C:\").\n   Returns 0 on success, -1 if the path would escape the root. */\nint normalize_rel(const char *in, char *out, size_t n) {\n    char tmp[PATH_LEN], *cur, *tok;\n    size_t len = 0;\n    if (!in || !*in || strlen(in) >= sizeof tmp || n < 2) return -1;\n    strcpy(tmp, in);\n#ifdef _WIN32\n    for (cur = tmp; *cur; cur++) {\n        if (*cur == '\\\\') *cur = '/';\n        else if (*cur == ':') return -1;\n    }\n#endif\n    if (tmp[0] == '/') return -1;\n    out[0] = '\\0';\n    cur = tmp;\n    while ((tok = path_next(&cur)) != NULL) {\n        size_t tl = strlen(tok);\n        if (!strcmp(tok, \".\")) continue;\n        if (!strcmp(tok, \"..\")) return -1;\n        if (len + tl + 2 > n) return -1;\n        if (len) out[len++] = '/';\n        memcpy(out + len, tok, tl);\n        len += tl;\n        out[len] = '\\0';\n    }\n    if (!len) strcpy(out, \".\");\n    return 0;\n}\n\n/* ---------- platform helpers ---------- */\n\nstatic int cmp_names(const void *a, const void *b) {\n    const char *x = *(char *const *)a, *y = *(char *const *)b;\n    for (; *x && *y; x++, y++) {\n        int cx = tolower((unsigned char)*x), cy = tolower((unsigned char)*y);\n        if (cx != cy) return cx - cy;\n    }\n    return (unsigned char)*x - (unsigned char)*y;\n}\n\n/* Replacement for scandir(): returns names sorted case-insensitively. */\nint plat_list_dir(const char *dir, char ***names) {\n    DIR *d = opendir(dir);\n    struct dirent *de;\n    char **arr = NULL;\n    size_t n = 0, cap = 0;\n    if (!d) return -1;\n    while ((de = readdir(d)) != NULL) {\n        if (!strcmp(de->d_name, \".\") || !strcmp(de->d_name, \"..\")) continue;\n        if (n == cap) {\n            cap = cap ? cap * 2 : 16;\n            arr = realloc(arr, cap * sizeof *arr);\n            if (!arr) { fprintf(stderr, \"fatal: out of memory\\n\"); exit(1); }\n        }\n        arr[n] = xmalloc(strlen(de->d_name) + 1);\n        strcpy(arr[n], de->d_name);\n        n++;\n    }\n    closedir(d);\n    if (n > 1) qsort(arr, n, sizeof *arr, cmp_names);\n    *names = arr;\n    return (int)n;\n}\n\nvoid plat_free_names(char **names, int n) {\n    int i;\n    for (i = 0; i < n; i++) free(names[i]);\n    free(names);\n}\n\n/* Absolute path of `in`, always with '/' separators. */\nint plat_realpath(const char *in, char *out, size_t n) {\n    char buf[4096];\n#ifdef _WIN32\n    char *p;\n    if (!_fullpath(buf, in, sizeof buf)) return -1;\n    for (p = buf; *p; p++) if (*p == '\\\\') *p = '/';\n#else\n    if (!realpath(in, buf)) return -1;\n#endif\n    if (strlen(buf) >= n) return -1;\n    strcpy(out, buf);\n    return 0;\n}\n"
  },
