    "content": "#include \"commands.h\"\n#include <stdio.h>\n#include <string.h>\n\n#define MAX_ARGS 32\n\nint main(int argc, char **argv) {\n    Engine e;\n    const char *root = (argc > 1) ? argv[1] : \"./sandbox\";\n\n    if (engine_open(&e, root) != 0) return 1;\n\n    /* One-shot mode:  fse <root> <command> [args...] */\n    if (argc > 2) {\n        run_command(&e, argc - 2, argv + 2, 0);\n        engine_close(&e);\n        return 0;\n    }\n\n    printf(\"\\n  DSA File Search Engine\\n  Managing: %s\\n  Indexed %lu entries in %.2f ms.  Type 'help' for commands, 'demo' for sample data.\\n\\n\",\n           e.root, UL(e.list.count), e.scan_ms);\n\n    for (;;) {\n        char line[2048], *args[MAX_ARGS];\n        int n;\n        if (PLAT_ISATTY(0)) { printf(\"fse> \"); fflush(stdout); }\n        if (!fgets(line, sizeof line, stdin)) break;\n        n = tokenize(line, args, MAX_ARGS);\n        if (run_command(&e, n, args, 1)) break;\n    }\n    engine_close(&e);\n    return 0;\n}\n"
  },
