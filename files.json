    "modifiedAt": "2026-10-30T10:36:21.134Z",
    "content": "#ifndef PLATFORM_H\n#define PLATFORM_H\n/* Small portability layer so the same code builds with GCC on Linux/macOS\n   and with MinGW-w64 GCC on Windows. */\n#include <sys/stat.h>\n#include <sys/types.h>\n\n#ifdef _WIN32\n  #include <direct.h>\n  #include <io.h>\n  #include <fcntl.h>\n  #define PLAT_MKDIR(p)   _mkdir(p)\n  #define PLAT_ISATTY(fd) _isatty(fd)\n  #define OPEN_EXTRA      O_BINARY\n  #define lstat           stat          /* no symlink-aware stat on Windows */\n  #ifndef S_ISLNK\n  #define S_ISLNK(m)      0\n  #endif\n  /* plain ASCII tree drawing: the Windows console may not show UTF-8 */\n  #define TREE_LAST   \"`-- \"\n  #define TREE_MID    \"|-- \"\n  #define TREE_PIPE   \"|   \"\n#else\n  #include <unistd.h>\n  #include <fcntl.h>\n  #define PLAT_MKDIR(p)   mkdir((p), 0755)\n  #define PLAT_ISATTY(fd) isatty(fd)\n  #define OPEN_EXTRA      0\n  #define TREE_LAST   \"└── \"\n  #define TREE_MID    \"├── \"\n  #define TREE_PIPE   \"│   \"\n#endif\n\n/* implemented in util.c */\nint  plat_list_dir(const char *dir, char ***names);   /* sorted names (no . and ..), returns count or -1 */\nvoid plat_free_names(char **names, int n);\nint  plat_realpath(const char *in, char *out, size_t n);\n#endif\n"
  },
