    "id": "fse-project/fse/src/commands.c",
    "name": "commands.c",
    "path": "fse-project/fse/src/commands.c",
    "extension": ".c",
    "isFolder": false,
    "size": 18174,
    "modifiedAt": "2026-10-30T10:36:20.531Z",
    "content": "#include \"commands.h\"\n#include <ctype.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#define LIST_LIMIT 200\n\n/* ---------- helpers ---------- */\n\nstatic void print_row(const FileRecord *r) {\n    char sz[32], tm[32];\n    human_size(r->size, sz, sizeof sz);\n    fmt_time(r->mtime, tm, sizeof tm);\n    printf(\"  %-4s %10s  %s  %s%s\\n\", r->is_dir ? \"DIR\" : \"FILE\", sz, tm, r->path, r->is_dir ? \"/\" : \"\");\n}\n\nstatic int cmp_by_path(const void *a, const void *b) {\n    return strcmp((*(FileRecord *const *)a)->path, (*(FileRecord *const *)b)->path);\n}\n\nstatic void print_results(RecVec *v, size_t limit) {\n    size_t i; long long total = 0; char sz[32];\n    for (i = 0; i < v->count && i < limit; i++) print_row(v->items[i]);\n    if (v->count > limit) printf(\"  ... and %lu more (refine your query or use limit=N)\\n\", UL(v->count - limit));\n    for (i = 0; i < v->count; i++) if (!v->items[i]->is_dir) total += v->items[i]->size;\n    human_size(total, sz, sizeof sz);\n    printf(\"  -> %lu result(s), %s in files\\n\", UL(v->count), sz);\n}\n\nstatic int is_number(const char *s) {\n    if (!*s) return 0;\n    for (; *s; s++) if (!isdigit((unsigned char)*s)) return 0;\n    return 1;\n}\n\n/* ---------- commands ---------- */\n\nvoid print_help(void) {\n    puts(\n\"\\n\"\n\"  Browsing\\n\"\n\"    ls [path]                  list one folder\\n\"\n\"    tree [path] [depth]        show the folder tree (default depth 3)\\n\"\n\"    scan                       re-index the root folder\\n\"\n\"    pwd                        show the managed root folder\\n\"\n\"  Searching\\n\"\n\"    find <exact_name>          O(1) exact filename lookup   (hash table)\\n\"\n\"    search <prefix>            prefix search, case-insens.  (trie)\\n\"\n\"    filter key=value ...       keys: ext= type=file|dir min= max= newer= older=\\n\"\n\"                               contains= sort=name|size|date order=asc|desc limit=\\n\"\n\"                               e.g.  filter ext=c min=1k sort=size\\n\"\n\"                                     filter type=file newer=7 (modified in last 7 days)\\n\"\n\"    dups                       find duplicate files by content\\n\"\n\"    related <path>             files linked to this one (graph + BFS)\\n\"\n\"    stats                      storage dashboard\\n\"\n\"  Managing files\\n\"\n\"    mkdir <path>               create folder (parents created as needed)\\n\"\n\"    touch <path> [text...]     create a file, optionally with content\\n\"\n\"    rename <path> <new>        rename in place (bare name) or move (path)\\n\"\n\"    mv <path> <dest>           same as rename\\n\"\n\"    rm [-r] [-f] <path>        delete a file / folder (-r recursive, -f no prompt)\\n\"\n\"  Other\\n\"\n\"    demo                       fill the root with sample files\\n\"\n\"    help, exit\\n\");\n}\n\nstatic void cmd_scan(Engine *e) {\n    char sz[32];\n    engine_rebuild(e);\n    human_size(e->tree->rec->size, sz, sizeof sz);\n    printf(\"Indexed %lu entries (%s) in %.2f ms, max depth %d\\n\", UL(e->list.count), sz, e->scan_ms, e->max_depth);\n}\n\nstatic void cmd_ls(Engine *e, const char *path) {\n    char rel[PATH_LEN];\n    TreeNode *n, *c;\n    if (normalize_rel(path, rel, sizeof rel)) { printf(\"Invalid path.\\n\"); return; }\n    n = tree_find(e->tree, rel);\n    if (!n) { printf(\"'%s' not found.\\n\", rel); return; }\n    if (!n->rec->is_dir) { print_row(n->rec); return; }\n    printf(\"%s/\\n\", strcmp(rel, \".\") ? rel : n->rec->name);\n    if (!n->first_child) puts(\"  (empty)\");\n    for (c = n->first_child; c; c = c->next_sibling) {\n        char sz[32], tm[32];\n        human_size(c->rec->size, sz, sizeof sz);\n        fmt_time(c->rec->mtime, tm, sizeof tm);\n        printf(\"  %-4s %10s  %s  %s%s\\n\", c->rec->is_dir ? \"DIR\" : \"FILE\", sz, tm, c->rec->name, c->rec->is_dir ? \"/\" : \"\");\n    }\n}\n\nstatic void cmd_tree(Engine *e, int argc, char **argv) {\n    const char *path = \".\"; int depth = 3, i;\n    char rel[PATH_LEN];\n    TreeNode *n;\n    for (i = 1; i < argc; i++) { if (is_number(argv[i])) depth = atoi(argv[i]); else path = argv[i]; }\n    if (normalize_rel(path, rel, sizeof rel)) { printf(\"Invalid path.\\n\"); return; }\n    n = tree_find(e->tree, rel);\n    if (!n || !n->rec->is_dir) { printf(\"'%s' is not a folder.\\n\", rel); return; }\n    tree_print(n, depth);\n}\n\nstatic void cmd_find(Engine *e, const char *name) {\n    RecVec v; double t0 = now_ms(), us; size_t i;\n    recvec_init(&v);\n    ht_lookup(&e->ht, name, &v);\n    us = (now_ms() - t0) * 1000.0;\n    if (!v.count) printf(\"No entry named exactly '%s'. (Try: search %.3s)\\n\", name, name);\n    else {\n        if (v.count > 1) qsort(v.items, v.count, sizeof *v.items, cmp_by_path);\n        for (i = 0; i < v.count; i++) print_row(v.items[i]);\n    }\n    printf(\"  -> %lu match(es) via hash table in %.1f us\\n\", UL(v.count), us);\n    recvec_free(&v);\n}\n\nstatic void cmd_search(Engine *e, const char *prefix) {\n    RecVec v; double t0 = now_ms(), us;\n    recvec_init(&v);\n    trie_prefix(e->trie, prefix, &v);\n    us = (now_ms() - t0) * 1000.0;\n    if (v.count > 1) qsort(v.items, v.count, sizeof *v.items, cmp_by_path);\n    print_results(&v, LIST_LIMIT);\n    printf(\"  (trie prefix search took %.1f us)\\n\", us);\n    recvec_free(&v);\n}\n\n/* ----- filter ----- */\n\ntypedef struct {\n    int has_ext; char ext[EXT_LEN];\n    int type;                                   /* 0 any, 1 file, 2 dir */\n    int has_min, has_max; long long min, max;\n    int has_newer, has_older; double newer, older;\n    char contains[NAME_LEN];\n} Filter;\n\nstatic int parse_size(const char *s, long long *out) {\n    char *end; double v = strtod(s, &end), mult = 1;\n    if (end == s || v < 0) return -1;\n    switch (tolower((unsigned char)*end)) {\n        case '\\0': case 'b': break;\n        case 'k': mult = 1024.0; break;\n        case 'm': mult = 1048576.0; break;\n        case 'g': mult = 1073741824.0; break;\n        default: return -1;\n    }\n    *out = (long long)(v * mult);\n    return 0;\n}\n\nstatic int g_sort_key = 0, g_desc = 0;          /* 0 name, 1 size, 2 date */\nstatic int cmp_filtered(const void *a, const void *b) {\n    const FileRecord *x = *(FileRecord *const *)a, *y = *(FileRecord *const *)b;\n    int c;\n    if (g_sort_key == 1)      c = (x->size > y->size) - (x->size < y->size);\n    else if (g_sort_key == 2) c = (x->mtime > y->mtime) - (x->mtime < y->mtime);\n    else                      c = strcmp(x->path, y->path);\n    if (c == 0) c = strcmp(x->path, y->path);\n    return g_desc ? -c : c;\n}\n\nstatic void cmd_filter(Engine *e, int argc, char **argv) {\n    Filter f; int i, order_set = 0; size_t limit = LIST_LIMIT;\n    const FileRecord *r; RecVec v; time_t now = time(NULL);\n    memset(&f, 0, sizeof f);\n    g_sort_key = 0; g_desc = 0;\n\n    if (argc < 2) { puts(\"Usage: filter key=value ...   (see 'help')\"); return; }\n    for (i = 1; i < argc; i++) {\n        char *eq = strchr(argv[i], '='), *val;\n        char key[32];\n        if (!eq || eq == argv[i] || !eq[1]) { printf(\"Bad filter '%s' (expected key=value)\\n\", argv[i]); return; }\n        snprintf(key, sizeof key, \"%.*s\", (int)(eq - argv[i]), argv[i]);\n        str_lower(key);\n        val = eq + 1;\n        if (!strcmp(key, \"ext\")) {\n            if (*val == '.') val++;\n            snprintf(f.ext, sizeof f.ext, \"%s\", val); str_lower(f.ext); f.has_ext = 1;\n        } else if (!strcmp(key, \"type\")) {\n            if (!strcmp(val, \"file\")) f.type = 1; else if (!strcmp(val, \"dir\")) f.type = 2;\n            else { puts(\"type must be file or dir\"); return; }\n        } else if (!strcmp(key, \"min\")) {\n            if (parse_size(val, &f.min)) { puts(\"Bad size for min= (try 500, 10k, 2m)\"); return; } f.has_min = 1;\n        } else if (!strcmp(key, \"max\")) {\n            if (parse_size(val, &f.max)) { puts(\"Bad size for max= (try 500, 10k, 2m)\"); return; } f.has_max = 1;\n        } else if (!strcmp(key, \"newer\")) { f.newer = atof(val); f.has_newer = 1;\n        } else if (!strcmp(key, \"older\")) { f.older = atof(val); f.has_older = 1;\n        } else if (!strcmp(key, \"contains\")) { snprintf(f.contains, sizeof f.contains, \"%s\", val); str_lower(f.contains);\n        } else if (!strcmp(key, \"sort\")) {\n            if (!strcmp(val, \"name\")) g_sort_key = 0; else if (!strcmp(val, \"size\")) g_sort_key = 1;\n            else if (!strcmp(val, \"date\")) g_sort_key = 2; else { puts(\"sort must be name, size or date\"); return; }\n            if (!order_set) g_desc = (g_sort_key != 0);\n        } else if (!strcmp(key, \"order\")) {\n            g_desc = !strcmp(val, \"desc\"); order_set = 1;\n        } else if (!strcmp(key, \"limit\")) { limit = (size_t)atol(val); if (!limit) limit = LIST_LIMIT;\n        } else { printf(\"Unknown filter key '%s'\\n\", key); return; }\n    }\n\n    recvec_init(&v);\n    for (r = e->list.head; r; r = r->next) {                 /* linked-list traversal */\n        double age = difftime(now, r->mtime) / 86400.0;\n        if (f.type == 1 && r->is_dir) continue;\n        if (f.type == 2 && !r->is_dir) continue;\n        if (f.has_ext && strcmp(r->ext, f.ext) != 0) continue;\n        if (f.has_min && r->size < f.min) continue;\n        if (f.has_max && r->size > f.max) continue;\n        if (f.has_newer && age > f.newer) continue;\n        if (f.has_older && age < f.older) continue;\n        if (f.contains[0]) {\n            char low[NAME_LEN]; snprintf(low, sizeof low, \"%s\", r->name); str_lower(low);\n            if (!strstr(low, f.contains)) continue;\n        }\n        recvec_push(&v, (FileRecord *)r);\n    }\n    if (v.count > 1) qsort(v.items, v.count, sizeof *v.items, cmp_filtered);\n    print_results(&v, limit);\n    recvec_free(&v);\n}\n\n/* ----- duplicates & graph ----- */\n\nstatic void cmd_dups(Engine *e) {\n    size_t g, m; char a[32], b[32]; long long total = 0; const FileRecord *r;\n    double t0 = now_ms();\n    engine_ensure_dups(e);\n    if (!e->dups.count) { puts(\"No duplicate files found.\"); return; }\n    for (g = 0; g < e->dups.count; g++) {\n        const DupGroup *d = &e->dups.groups[g];\n        human_size(d->size, a, sizeof a);\n        human_size(d->size * (long long)(d->count - 1), b, sizeof b);\n        printf(\"Group %lu: %lu identical copies of %s (wasting %s)\\n\", UL(g + 1), UL(d->count), a, b);\n        for (m = 0; m < d->count; m++) printf(\"    %s\\n\", d->members[m]->path);\n    }\n    for (r = e->list.head; r; r = r->next) if (!r->is_dir) total += r->size;\n    human_size(e->dups.wasted, a, sizeof a);\n    printf(\"-> %lu group(s), %lu redundant file(s), %s reclaimable (%.1f%% of all file data)  [%.1f ms]\\n\",\n           UL(e->dups.count), UL(e->dups.extra_files), a, total ? 100.0 * (double)e->dups.wasted / (double)total : 0.0, now_ms() - t0);\n}\n\nstatic void visit_related(FileRecord *rec, FileRecord *from, RelType via, int dist, void *ctx) {\n    (void)ctx;\n    printf(\"  [%d] %-9s %-28s (via %s)\\n\", dist, via == REL_DUPLICATE ? \"DUPLICATE\" : \"SAME-NAME\",\n           rec->path, from->path);\n}\n\nstatic void cmd_related(Engine *e, const char *path) {\n    char rel[PATH_LEN]; TreeNode *n;\n    if (normalize_rel(path, rel, sizeof rel)) { puts(\"Invalid path.\"); return; }\n    n = tree_find(e->tree, rel);\n    if (!n || n->rec->id < 0) { printf(\"'%s' not found.\\n\", rel); return; }\n    engine_ensure_graph(e);\n    printf(\"Files related to %s:\\n\", rel);\n    if (!e->graph.adj[n->rec->id]) puts(\"  (none)\");\n    else graph_bfs(&e->graph, n->rec->id, visit_related, NULL);\n}\n\n/* ----- dashboard ----- */\n\ntypedef struct ExtStat { char ext[EXT_LEN]; long count; long long bytes; struct ExtStat *next; } ExtStat;\nstatic long long key_size(const FileRecord *r)  { return r->size; }\nstatic long long key_mtime(const FileRecord *r) { return (long long)r->mtime; }\n\nstatic void insert_top(const FileRecord **top, int k, const FileRecord *r, long long (*key)(const FileRecord *)) {\n    int i = 0, j;\n    while (i < k && top[i] && key(top[i]) >= key(r)) i++;\n    if (i >= k) return;\n    for (j = k - 1; j > i; j--) top[j] = top[j - 1];\n    top[i] = r;\n}\nstatic int cmp_ext(const void *a, const void *b) {\n    const ExtStat *x = *(ExtStat *const *)a, *y = *(ExtStat *const *)b;\n    return (x->bytes < y->bytes) - (x->bytes > y->bytes);\n}\n\nstatic void bar(double frac) {\n    int w = (int)(frac * 30.0 + 0.5), i;\n    if (frac > 0 && w == 0) w = 1;\n    for (i = 0; i < w; i++) putchar('#');\n}\n\nstatic void cmd_stats(Engine *e) {\n    const FileRecord *r, *big[5] = {0}, *recent[5] = {0}, *bigdir[3] = {0};\n    long files = 0, dirs = 0; long long total = 0;\n    ExtStat *head = NULL, *s, **arr; size_t next = 0, i, used, maxc;\n    char a[32], b[32], tm[32];\n\n    for (r = e->list.head; r; r = r->next) {\n        if (r->is_dir) { dirs++; insert_top(bigdir, 3, r, key_size); continue; }\n        files++; total += r->size;\n        insert_top(big, 5, r, key_size);\n        insert_top(recent, 5, r, key_mtime);\n        for (s = head; s && strcmp(s->ext, r->ext); s = s->next) ;\n        if (!s) { s = xcalloc(1, sizeof *s); snprintf(s->ext, sizeof s->ext, \"%s\", r->ext); s->next = head; head = s; next++; }\n        s->count++; s->bytes += r->size;\n    }\n\n    human_size(total, a, sizeof a);\n    puts(\"\\n==================== STORAGE DASHBOARD ====================\");\n    printf(\" Root      : %s\\n\", e->root);\n    printf(\" Files     : %ld        Folders: %ld        Max depth: %d\\n\", files, dirs, e->max_depth);\n    printf(\" Total size: %s\", a);\n    if (files) { human_size(total / files, b, sizeof b); printf(\"        Average file: %s\", b); }\n    puts(\"\\n\");\n\n    puts(\" By file type (by size)\");\n    arr = xmalloc((next ? next : 1) * sizeof *arr);\n    for (i = 0, s = head; s; s = s->next) arr[i++] = s;\n    qsort(arr, next, sizeof *arr, cmp_ext);\n    for (i = 0; i < next && i < 8; i++) {\n        double frac = total ? (double)arr[i]->bytes / (double)total : 0;\n        char nm[40]; human_size(arr[i]->bytes, a, sizeof a);\n        snprintf(nm, sizeof nm, \"%s%s\", arr[i]->ext[0] ? \".\" : \"\", arr[i]->ext[0] ? arr[i]->ext : \"(none)\");\n        printf(\"   %-8s %4ld file(s) %10s %5.1f%% \", nm, arr[i]->count, a, frac * 100);\n        bar(frac); putchar('\\n');\n    }\n    if (!next) puts(\"   (no files)\");\n\n    puts(\"\\n Largest files\");\n    for (i = 0; i < 5 && big[i]; i++) { human_size(big[i]->size, a, sizeof a); printf(\"   %10s  %s\\n\", a, big[i]->path); }\n    puts(\"\\n Largest folders\");\n    for (i = 0; i < 3 && bigdir[i]; i++) { human_size(bigdir[i]->size, a, sizeof a); printf(\"   %10s  %s/\\n\", a, bigdir[i]->path); }\n    puts(\"\\n Recently modified\");\n    for (i = 0; i < 5 && recent[i]; i++) { fmt_time(recent[i]->mtime, tm, sizeof tm); printf(\"   %s  %s\\n\", tm, recent[i]->path); }\n\n    engine_ensure_dups(e);\n    human_size(e->dups.wasted, a, sizeof a);\n    printf(\"\\n Duplicates: %lu group(s), %lu redundant file(s), %s reclaimable\\n\", UL(e->dups.count), UL(e->dups.extra_files), a);\n\n    ht_stats(&e->ht, &used, &maxc);\n    printf(\"\\n Index internals\\n   Hash table : %lu entries / %lu buckets (load %.2f, longest chain %lu)\\n\",\n           UL(e->ht.count), UL(e->ht.cap), (double)e->ht.count / (double)e->ht.cap, UL(maxc));\n    printf(\"   Trie       : %lu nodes\\n   Graph      : %s\\n   Last scan  : %.2f ms\\n\",\n           UL(trie_count_nodes(e->trie)), e->graph_ready ? \"built\" : \"not built yet (built on first 'related')\", e->scan_ms);\n    puts(\"============================================================\\n\");\n\n    while (head) { s = head->next; free(head); head = s; }\n    free(arr);\n}\n\n/* ---------- dispatcher ---------- */\n\nstatic int need(int argc, int n, const char *usage) {\n    if (argc < n) { printf(\"Usage: %s\\n\", usage); return 0; }\n    return 1;\n}\n\nint run_command(Engine *e, int argc, char **argv, int interactive) {\n    char cmd[32];\n    if (argc == 0) return 0;\n    snprintf(cmd, sizeof cmd, \"%s\", argv[0]); str_lower(cmd);\n\n    if (!strcmp(cmd, \"exit\") || !strcmp(cmd, \"quit\") || !strcmp(cmd, \"q\")) return 1;\n    else if (!strcmp(cmd, \"help\") || !strcmp(cmd, \"?\")) print_help();\n    else if (!strcmp(cmd, \"pwd\")) printf(\"%s\\n\", e->root);\n    else if (!strcmp(cmd, \"scan\")) cmd_scan(e);\n    else if (!strcmp(cmd, \"ls\")) cmd_ls(e, argc > 1 ? argv[1] : \".\");\n    else if (!strcmp(cmd, \"tree\")) cmd_tree(e, argc, argv);\n    else if (!strcmp(cmd, \"find\")) { if (need(argc, 2, \"find <exact_name>\")) cmd_find(e, argv[1]); }\n    else if (!strcmp(cmd, \"search\")) { if (need(argc, 2, \"search <prefix>\")) cmd_search(e, argv[1]); }\n    else if (!strcmp(cmd, \"filter\")) cmd_filter(e, argc, argv);\n    else if (!strcmp(cmd, \"dups\")) cmd_dups(e);\n    else if (!strcmp(cmd, \"related\")) { if (need(argc, 2, \"related <path>\")) cmd_related(e, argv[1]); }\n    else if (!strcmp(cmd, \"stats\") || !strcmp(cmd, \"dashboard\")) cmd_stats(e);\n    else if (!strcmp(cmd, \"mkdir\")) { if (need(argc, 2, \"mkdir <path>\")) engine_mkdir(e, argv[1]); }\n    else if (!strcmp(cmd, \"touch\")) {\n        if (need(argc, 2, \"touch <path> [text...]\")) {\n            char text[4096] = \"\"; int i;\n            for (i = 2; i < argc; i++) {\n                if (i > 2) strncat(text, \" \", sizeof text - strlen(text) - 1);\n                strncat(text, argv[i], sizeof text - strlen(text) - 1);\n            }\n            if (argc > 2) strncat(text, \"\\n\", sizeof text - strlen(text) - 1);\n            engine_touch(e, argv[1], text);\n        }\n    }\n    else if (!strcmp(cmd, \"rename\") || !strcmp(cmd, \"mv\")) { if (need(argc, 3, \"rename <path> <new_name_or_path>\")) engine_rename(e, argv[1], argv[2]); }\n    else if (!strcmp(cmd, \"rm\") || !strcmp(cmd, \"del\")) {\n        int rec = 0, force = 0, i; const char *target = NULL;\n        for (i = 1; i < argc; i++) {\n            if (!strcmp(argv[i], \"-r\")) rec = 1;\n            else if (!strcmp(argv[i], \"-f\")) force = 1;\n            else if (!strcmp(argv[i], \"-rf\") || !strcmp(argv[i], \"-fr\")) rec = force = 1;\n            else target = argv[i];\n        }\n        if (!target) puts(\"Usage: rm [-r] [-f] <path>\");\n        else {\n            if (rec && !force && interactive && PLAT_ISATTY(0)) {\n                char ans[16];\n                printf(\"Delete '%s' and everything inside it? [y/N] \", target);\n                if (!fgets(ans, sizeof ans, stdin) || tolower((unsigned char)ans[0]) != 'y') { puts(\"Cancelled.\"); return 0; }\n            }\n            engine_remove(e, target, rec);\n        }\n    }\n    else if (!strcmp(cmd, \"demo\")) engine_demo(e);\n    else printf(\"Unknown command '%s'. Type 'help'.\\n\", argv[0]);\n    return 0;\n}\n"
