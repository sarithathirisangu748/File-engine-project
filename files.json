    "content": "CC      = gcc\nCFLAGS  = -std=gnu11 -Wall -Wextra -O2\nSRC     = $(wildcard src/*.c)\nOBJ     = $(SRC:src/%.c=build/%.o)\n\nfse: $(OBJ)\n\t$(CC) $(CFLAGS) -o $@ $^\n\nbuild/%.o: src/%.c $(wildcard src/*.h) | build\n\t$(CC) $(CFLAGS) -c $< -o $@\n\nbuild:\n\tmkdir -p build\n\ndebug: CFLAGS = -std=gnu11 -Wall -Wextra -g -fsanitize=address,undefined\ndebug: clean fse\n\nclean:\n\trm -rf build fse\n\n.PHONY: clean debug\n"
