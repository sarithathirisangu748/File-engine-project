    "size": 1781,
    "modifiedAt": "2026-10-30T10:36:20.903Z",
    "content": "#include \"graph.h\"\n#include \"queue.h\"\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\nvoid graph_init(Graph *g, const FileList *l) {\n    const FileRecord *r;\n    g->n = (int)l->count; g->edges = 0;\n    g->adj   = xcalloc((size_t)g->n, sizeof(Edge *));\n    g->nodes = xcalloc((size_t)g->n, sizeof(FileRecord *));\n    for (r = l->head; r; r = r->next) g->nodes[r->id] = (FileRecord *)r;\n}\n\nstatic void add_dir_edge(Graph *g, int a, int b, RelType t) {\n    Edge *e = xmalloc(sizeof *e);\n    e->to = b; e->type = t; e->next = g->adj[a]; g->adj[a] = e;\n}\nvoid graph_add_edge(Graph *g, int a, int b, RelType t) {\n    add_dir_edge(g, a, b, t);\n    add_dir_edge(g, b, a, t);\n    g->edges++;\n}\n\n/* Breadth-first walk of the connected component containing `start`. */\nvoid graph_bfs(const Graph *g, int start, GraphVisit fn, void *ctx) {\n    char *seen = xcalloc((size_t)g->n, 1);\n    int *dist = xcalloc((size_t)g->n, sizeof(int));\n    Queue q;\n    q_init(&q);\n    seen[start] = 1;\n    q_push(&q, (void *)(intptr_t)(start + 1));     /* +1 so id 0 is not NULL */\n    while (!q_empty(&q)) {\n        int u = (int)(intptr_t)q_pop(&q) - 1;\n        const Edge *e;\n        for (e = g->adj[u]; e; e = e->next) {\n            if (!seen[e->to]) {\n                seen[e->to] = 1;\n                dist[e->to] = dist[u] + 1;\n                fn(g->nodes[e->to], g->nodes[u], e->type, dist[e->to], ctx);\n                q_push(&q, (void *)(intptr_t)(e->to + 1));\n            }\n        }\n    }\n    q_free(&q); free(seen); free(dist);\n}\n\nvoid graph_free(Graph *g) {\n    int i;\n    if (!g->adj) return;\n    for (i = 0; i < g->n; i++) {\n        Edge *e = g->adj[i];\n        while (e) { Edge *nx = e->next; free(e); e = nx; }\n    }\n    free(g->adj); free(g->nodes);\n    memset(g, 0, sizeof *g);\n}\n"
  },
  {
