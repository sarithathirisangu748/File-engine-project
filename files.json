    "size": 511,
    "modifiedAt": "2026-10-30T10:36:20.822Z",
    "content": "#include \"filelist.h\"\n#include <stdlib.h>\n\nvoid fl_init(FileList *l) { l->head = l->tail = NULL; l->count = 0; }\n\nFileRecord *fl_append(FileList *l, const FileRecord *t) {\n    FileRecord *r = xmalloc(sizeof *r);\n    *r = *t;\n    r->id = (int)l->count;\n    r->next = NULL;\n    if (l->tail) l->tail->next = r; else l->head = r;\n    l->tail = r;\n    l->count++;\n    return r;\n}\n\nvoid fl_clear(FileList *l) {\n    FileRecord *r = l->head;\n    while (r) { FileRecord *n = r->next; free(r); r = n; }\n    fl_init(l);\n}\n"
  },
  {
