    "modifiedAt": "2026-10-30T10:36:20.856Z",
    "content": "#ifndef FILELIST_H\n#define FILELIST_H\n#include \"common.h\"\n\n/* Singly linked list with tail pointer: O(1) append, O(n) traversal. */\ntypedef struct { FileRecord *head, *tail; size_t count; } FileList;\n\nvoid        fl_init(FileList *l);\nFileRecord *fl_append(FileList *l, const FileRecord *tmpl);\nvoid        fl_clear(FileList *l);\n#endif\n"
  },
  {
    "id": "fse-project/fse/src/graph.c",
    "name": "graph.c",
    "path": "fse-project/fse/src/graph.c",
