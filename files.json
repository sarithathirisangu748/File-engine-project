    "modifiedAt": "2026-10-30T10:36:21.189Z",
    "content": "#include \"queue.h\"\n#include \"common.h\"\n#include <stdlib.h>\n\nvoid q_init(Queue *q) { q->head = q->tail = NULL; q->size = 0; }\nint  q_empty(const Queue *q) { return q->head == NULL; }\n\nvoid q_push(Queue *q, void *data) {\n    QNode *n = xmalloc(sizeof *n);\n    n->data = data; n->next = NULL;\n    if (q->tail) q->tail->next = n; else q->head = n;\n    q->tail = n; q->size++;\n}\nvoid *q_pop(Queue *q) {\n    QNode *n = q->head;\n    void *d;\n    if (!n) return NULL;\n    d = n->data;\n    q->head = n->next;\n    if (!q->head) q->tail = NULL;\n    free(n); q->size--;\n    return d;\n}\nvoid q_free(Queue *q) { while (!q_empty(q)) q_pop(q); }\n"
  },
