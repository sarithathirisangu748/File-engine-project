    "modifiedAt": "2026-10-30T10:36:20.788Z",
    "content": "#ifndef ENGINE_H\n#define ENGINE_H\n#include \"common.h\"\n#include \"filelist.h\"\n#include \"hashtable.h\"\n#include \"trie.h\"\n#include \"tree.h\"\n#include \"graph.h\"\n#include \"dupes.h\"\n\ntypedef struct Engine {\n    char      root[PATH_LEN];       /* absolute path of the managed folder */\n    FileList  list;                 /* linked list of every record         */\n    HashTable ht;                   /* exact filename lookup               */\n    TrieNode *trie;                 /* prefix search                       */\n    TreeNode *tree;                 /* folder hierarchy                    */\n    int       max_depth;\n    double    scan_ms;\n    Graph     graph;   int graph_ready;   /* relationships (lazy) */\n    DupSet    dups;    int dups_ready;    /* duplicates    (lazy) */\n} Engine;\n\nint  engine_open(Engine *e, const char *root);\nvoid engine_close(Engine *e);\nvoid engine_rebuild(Engine *e);\nvoid engine_ensure_dups(Engine *e);\nvoid engine_ensure_graph(Engine *e);\n\nint  engine_mkdir(Engine *e, const char *rel);\nint  engine_touch(Engine *e, const char *rel, const char *content);\nint  engine_rename(Engine *e, const char *rel, const char *dest);\nint  engine_remove(Engine *e, const char *rel, int recursive);\nvoid engine_demo(Engine *e);\n#endif\n"
  },
  {
    "id": "fse-project/fse/src/filelist.c",
    "name": "filelist.c",
