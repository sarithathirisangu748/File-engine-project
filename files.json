    "size": 1845,
    "modifiedAt": "2026-10-30T10:36:20.612Z",
    "content": "#ifndef COMMON_H\n#define COMMON_H\n\n/* Old Windows C runtimes (MinGW.org / msvcrt) do not understand %zu or %lld,\n   so printf calls cast to unsigned long / long and use %lu / %ld. */\n#define UL(x) ((unsigned long)(x))\n\n#include <stddef.h>\n#include <stdint.h>\n#include <time.h>\n#include \"platform.h\"\n\n#define PATH_LEN 1024\n#define FULL_LEN (2 * PATH_LEN + 2)\n#define NAME_LEN 256\n#define EXT_LEN  32\n\n/* One entry of the master linked list. Every file/folder gets one record. */\ntypedef struct FileRecord {\n    int       id;                 /* index in the list (0..n-1); -1 for root */\n    char      name[NAME_LEN];\n    char      path[PATH_LEN];     /* relative to the engine root, \".\" = root */\n    char      ext[EXT_LEN];       /* lowercase, no dot, \"\" if none           */\n    int       is_dir;\n    int       depth;\n    long long size;               /* bytes (folders: recursive total)        */\n    time_t    mtime;\n    uint64_t  content_hash;       /* FNV-1a of contents, computed lazily     */\n    int       hashed;\n    struct FileRecord *next;\n} FileRecord;\n\n/* Small growable array of record pointers (used for result sets). */\ntypedef struct { FileRecord **items; size_t count, cap; } RecVec;\n\nvoid recvec_init(RecVec *v);\nvoid recvec_push(RecVec *v, FileRecord *r);\nvoid recvec_free(RecVec *v);\n\nvoid *xmalloc(size_t n);\nvoid *xcalloc(size_t n, size_t sz);\n\nvoid   human_size(long long bytes, char *out, size_t n);\nvoid   fmt_time(time_t t, char *out, size_t n);\ndouble now_ms(void);\nvoid   str_lower(char *s);\nint    tokenize(char *line, char **argv, int max);\n\nint path_join(char *out, size_t n, const char *a, const char *b);\nvoid full_path(const char *root, const char *rel, char *out);\nint  normalize_rel(const char *in, char *out, size_t n);\nchar *path_next(char **cursor);   /* next \"/\"-separated component, in place */\n\n#endif\n"
  },
