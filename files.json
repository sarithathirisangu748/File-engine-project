    "content": "#include \"engine.h\"\n#include <dirent.h>\n#include <errno.h>\n#include <fcntl.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/stat.h>\n#include <unistd.h>\n#include <utime.h>\n\n/* ---------- index management ---------- */\n\nstatic void index_free(Engine *e) {\n    ht_free(&e->ht);\n    trie_free(e->trie);  e->trie = NULL;\n    tree_free(e->tree);  e->tree = NULL;\n    fl_clear(&e->list);\n    if (e->graph_ready) { graph_free(&e->graph); e->graph_ready = 0; }\n    if (e->dups_ready)  { dup_free(&e->dups);    e->dups_ready  = 0; }\n}\n\nvoid engine_rebuild(Engine *e) {\n    const FileRecord *r;\n    double t0 = now_ms();\n    index_free(e);\n    fl_init(&e->list);\n    e->tree = tree_build(e->root, &e->list, &e->max_depth);\n    ht_init(&e->ht, 256);\n    e->trie = trie_new();\n    for (r = e->list.head; r; r = r->next) {\n        ht_insert(&e->ht, (FileRecord *)r);\n        trie_insert(e->trie, r->name, (FileRecord *)r);\n    }\n    e->scan_ms = now_ms() - t0;\n}\n\nstatic int mkdir_p_full(const char *full) {\n    char tmp[FULL_LEN], *p;\n    snprintf(tmp, sizeof tmp, \"%s\", full);\n    for (p = tmp + 1; *p; p++)\n        if (*p == '/') { *p = '\\0'; PLAT_MKDIR(tmp); *p = '/'; }\n    if (PLAT_MKDIR(tmp) != 0 && errno != EEXIST) return -1;\n    return 0;\n}\n\nint engine_open(Engine *e, const char *root) {\n    struct stat st;\n    memset(e, 0, sizeof *e);\n    if (stat(root, &st) != 0) {\n        if (mkdir_p_full(root) != 0) { perror(\"cannot create root folder\"); return -1; }\n    } else if (!S_ISDIR(st.st_mode)) {\n        fprintf(stderr, \"'%s' is not a folder\\n\", root); return -1;\n    }\n    {\n        if (plat_realpath(root, e->root, sizeof e->root) != 0) { fprintf(stderr, \"cannot resolve path '%s'\\n\", root); return -1; }\n    }\n    engine_rebuild(e);\n    return 0;\n}\n\nvoid engine_close(Engine *e) { index_free(e); }\n\nvoid engine_ensure_dups(Engine *e) {\n    if (e->dups_ready) return;\n    dup_find(e->root, &e->list, &e->dups);\n    e->dups_ready = 1;\n}\n\nstatic void chain(Engine *e, FileRecord **items, size_t n, RelType t) {\n    size_t i;\n    for (i = 0; i + 1 < n; i++) graph_add_edge(&e->graph, items[i]->id, items[i + 1]->id, t);\n}\n\nvoid engine_ensure_graph(Engine *e) {\n    const FileRecord *r;\n    size_t i;\n    if (e->graph_ready) return;\n    engine_ensure_dups(e);\n    graph_init(&e->graph, &e->list);\n    for (i = 0; i < e->dups.count; i++)\n        chain(e, e->dups.groups[i].members, e->dups.groups[i].count, REL_DUPLICATE);\n    for (r = e->list.head; r; r = r->next) {\n        RecVec v; recvec_init(&v);\n        ht_lookup(&e->ht, r->name, &v);\n        if (v.count > 1 && v.items[0] == r) chain(e, v.items, v.count, REL_SAMENAME);\n        recvec_free(&v);\n    }\n    e->graph_ready = 1;\n}\n\n/* ---------- file operations (all paths confined to the root) ---------- */\n\nstatic int parent_of(const char *rel, char *out, size_t n) {\n    const char *s = strrchr(rel, '/');\n    if (!s) return -1;\n    snprintf(out, n, \"%.*s\", (int)(s - rel), rel);\n    return 0;\n}\n\nint engine_mkdir(Engine *e, const char *in) {\n    char rel[PATH_LEN], full[FULL_LEN];\n    struct stat st;\n    if (normalize_rel(in, rel, sizeof rel) || !strcmp(rel, \".\")) { printf(\"Invalid path.\\n\"); return -1; }\n    full_path(e->root, rel, full);\n    if (lstat(full, &st) == 0) { printf(\"'%s' already exists.\\n\", rel); return -1; }\n    if (mkdir_p_full(full)) { perror(\"mkdir\"); return -1; }\n    engine_rebuild(e);\n    printf(\"Created folder %s/\\n\", rel);\n    return 0;\n}\n\nstatic int write_file(Engine *e, const char *rel, const char *content, int exclusive) {\n    char full[FULL_LEN], par[PATH_LEN], pfull[FULL_LEN];\n    int fd, flags = O_WRONLY | O_CREAT | OPEN_EXTRA | (exclusive ? O_EXCL : O_TRUNC);\n    full_path(e->root, rel, full);\n    if (parent_of(rel, par, sizeof par) == 0) {\n        full_path(e->root, par, pfull);\n        mkdir_p_full(pfull);\n    }\n    fd = open(full, flags, 0644);\n    if (fd < 0) return -1;\n    if (content && *content) {\n        size_t len = strlen(content), off = 0;\n        while (off < len) {\n            long w = (long)write(fd, content + off, (unsigned)(len - off));\n            if (w <= 0) break;\n            off += (size_t)w;\n        }\n    }\n    close(fd);\n    return 0;\n}\n\nint engine_touch(Engine *e, const char *in, const char *content) {\n    char rel[PATH_LEN];\n    if (normalize_rel(in, rel, sizeof rel) || !strcmp(rel, \".\")) { printf(\"Invalid path.\\n\"); return -1; }\n    if (write_file(e, rel, content, 1) != 0) {\n        if (errno == EEXIST) printf(\"'%s' already exists.\\n\", rel);\n        else perror(\"touch\");\n        return -1;\n    }\n    engine_rebuild(e);\n    printf(\"Created file %s\\n\", rel);\n    return 0;\n}\n\nint engine_rename(Engine *e, const char *src_in, const char *dst_in) {\n    char src[PATH_LEN], dst[PATH_LEN], cand[2 * PATH_LEN + 2], par[PATH_LEN];\n    char fsrc[FULL_LEN], fdst[FULL_LEN], pfull[FULL_LEN];\n    struct stat st;\n    size_t sl;\n\n    if (normalize_rel(src_in, src, sizeof src) || !strcmp(src, \".\")) { printf(\"Invalid source path.\\n\"); return -1; }\n    full_path(e->root, src, fsrc);\n    if (lstat(fsrc, &st) != 0) { printf(\"'%s' does not exist.\\n\", src); return -1; }\n\n    if (strlen(dst_in) >= PATH_LEN / 2) { printf(\"Destination too long.\\n\"); return -1; }\n    if (!strchr(dst_in, '/') && parent_of(src, par, sizeof par) == 0)\n        snprintf(cand, sizeof cand, \"%s/%s\", par, dst_in);     /* bare name: rename in place */\n    else\n        snprintf(cand, sizeof cand, \"%s\", dst_in);             /* path: move */\n    if (normalize_rel(cand, dst, sizeof dst) || !strcmp(dst, \".\")) { printf(\"Invalid destination.\\n\"); return -1; }\n\n    sl = strlen(src);\n    if (!strncmp(dst, src, sl) && dst[sl] == '/') { printf(\"Cannot move a folder into itself.\\n\"); return -1; }\n    full_path(e->root, dst, fdst);\n    if (lstat(fdst, &st) == 0) { printf(\"'%s' already exists.\\n\", dst); return -1; }\n    if (parent_of(dst, par, sizeof par) == 0) { full_path(e->root, par, pfull); mkdir_p_full(pfull); }\n    if (rename(fsrc, fdst) != 0) { perror(\"rename\"); return -1; }\n    engine_rebuild(e);\n    printf(\"Renamed %s -> %s\\n\", src, dst);\n    return 0;\n}\n\nstatic long rm_rf(const char *full) {\n    struct stat st;\n    long count = 0;\n    if (lstat(full, &st) != 0) return -1;\n    if (S_ISDIR(st.st_mode)) {\n        DIR *d = opendir(full);\n        struct dirent *de;\n        if (!d) return -1;\n        while ((de = readdir(d))) {\n            char child[FULL_LEN];\n            long c;\n            if (!strcmp(de->d_name, \".\") || !strcmp(de->d_name, \"..\")) continue;\n            snprintf(child, sizeof child, \"%s/%s\", full, de->d_name);\n            c = rm_rf(child);\n            if (c < 0) { closedir(d); return -1; }\n            count += c;\n        }\n        closedir(d);\n        if (rmdir(full) != 0) return -1;\n    } else if (unlink(full) != 0) return -1;\n    return count + 1;\n}\n\nint engine_remove(Engine *e, const char *in, int recursive) {\n    char rel[PATH_LEN], full[FULL_LEN];\n    struct stat st;\n    if (normalize_rel(in, rel, sizeof rel) || !strcmp(rel, \".\")) { printf(\"Invalid path.\\n\"); return -1; }\n    full_path(e->root, rel, full);\n    if (lstat(full, &st) != 0) { printf(\"'%s' does not exist.\\n\", rel); return -1; }\n    if (S_ISDIR(st.st_mode) && !recursive) {\n        if (rmdir(full) != 0) { printf(\"'%s' is not empty. Use: rm -r %s\\n\", rel, rel); return -1; }\n        engine_rebuild(e);\n        printf(\"Deleted empty folder %s/\\n\", rel);\n        return 0;\n    }\n    {\n        long n = rm_rf(full);\n        if (n < 0) { perror(\"rm\"); engine_rebuild(e); return -1; }\n        engine_rebuild(e);\n        printf(\"Deleted %s (%ld item%s)\\n\", rel, n, n == 1 ? \"\" : \"s\");\n    }\n    return 0;\n}\n\n/* ---------- demo data ---------- */\n\nstatic char *gen_lines(int lines, const char *tag) {\n    size_t cap = (size_t)lines * 48 + 16, len = 0;\n    char *buf = xmalloc(cap);\n    int i;\n    buf[0] = '\\0';\n    for (i = 0; i < lines; i++)\n        len += (size_t)snprintf(buf + len, cap - len, \"%s,%d,%d,%d\\n\", tag, i, (i * 7919) % 1000, (i * 31) % 97);\n    return buf;\n}\nstatic void put(Engine *e, const char *rel, const char *content, int age_days) {\n    write_file(e, rel, content, 0);\n    if (age_days > 0) {\n        char full[FULL_LEN];\n        struct utimbuf ub;\n        time_t t = time(NULL) - (time_t)age_days * 86400;\n        ub.actime = ub.modtime = t;\n        full_path(e->root, rel, full);\n        utime(full, &ub);\n    }\n}\n\nvoid engine_demo(Engine *e) {\n    char *csv  = gen_lines(3000, \"sales\");\n    char *csv2 = gen_lines(400,  \"sales\");\n    char *img  = gen_lines(900,  \"IMG1\");\n    char *img2 = gen_lines(1500, \"IMG2\");\n    char *png  = gen_lines(2000, \"PNG\");\n    const char *rep = \"Quarterly report\\nRevenue up 12%, costs flat.\\nNext steps: hire two engineers.\\n\";\n    const char *rdm = \"# Project\\nA small demo project for the file search engine.\\n\";\n    const char *mc  = \"#include <stdio.h>\\nint main(void){ puts(\\\"hello\\\"); return 0; }\\n\";\n\n    put(e, \"docs/report.txt\", rep, 40);\n    put(e, \"docs/report_final.txt\", rep, 40);\n    put(e, \"docs/report_draft.txt\", \"Quarterly report (draft)\\n\", 60);\n    put(e, \"docs/notes/todo.txt\", \"1. write tests\\n2. review code\\n\", 3);\n    put(e, \"docs/notes/readme.md\", rdm, 0);\n    put(e, \"readme.md\", rdm, 0);\n    put(e, \"src/main.c\", mc, 1);\n    put(e, \"src/backup/main.c\", mc, 20);\n    put(e, \"src/utils.c\", \"int add(int a, int b){ return a + b; }\\n\", 2);\n    put(e, \"src/utils.h\", \"int add(int a, int b);\\n\", 2);\n    put(e, \"photos/cat.jpg\", img, 100);\n    put(e, \"photos/cat_copy.jpg\", img, 100);\n    put(e, \"photos/trip/cat.jpg\", img2, 10);\n    put(e, \"photos/trip/beach.png\", png, 5);\n    put(e, \"data/sales.csv\", csv, 7);\n    put(e, \"data/sales_old.csv\", csv2, 400);\n    put(e, \"logs/app.log\", \"started\\nready\\n\", 0);\n    put(e, \"logs/app_2023.log\", \"started\\nstopped\\n\", 900);\n    {\n        char full[FULL_LEN];\n        full_path(e->root, \"empty_folder\", full);\n        mkdir_p_full(full);\n    }\n    free(csv); free(csv2); free(img); free(img2); free(png);\n    engine_rebuild(e);\n    printf(\"Demo data created.\\n\");\n}\n"
  },
  {
