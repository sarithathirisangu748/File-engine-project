    "modifiedAt": "2026-10-30T10:36:20.665Z",
    "content": "#include \"dupes.h\"\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic int ensure_hash(const char *root, FileRecord *r) {\n    char full[FULL_LEN];\n    unsigned char buf[65536];\n    uint64_t h = 1469598103934665603ULL;\n    size_t n, i;\n    FILE *f;\n    if (r->hashed) return 0;\n    full_path(root, r->path, full);\n    f = fopen(full, \"rb\");\n    if (!f) return -1;\n    while ((n = fread(buf, 1, sizeof buf, f)) > 0)\n        for (i = 0; i < n; i++) { h ^= buf[i]; h *= 1099511628211ULL; }\n    fclose(f);\n    r->content_hash = h; r->hashed = 1;\n    return 0;\n}\n\nstatic int files_identical(const char *root, const FileRecord *a, const FileRecord *b) {\n    char fa[FULL_LEN], fb[FULL_LEN];\n    unsigned char ba[8192], bb[8192];\n    FILE *x, *y; int same = 1;\n    full_path(root, a->path, fa); full_path(root, b->path, fb);\n    x = fopen(fa, \"rb\"); y = fopen(fb, \"rb\");\n    if (!x || !y) { if (x) fclose(x); if (y) fclose(y); return 0; }\n    for (;;) {\n        size_t na = fread(ba, 1, sizeof ba, x), nb = fread(bb, 1, sizeof bb, y);\n        if (na != nb || memcmp(ba, bb, na) != 0) { same = 0; break; }\n        if (na == 0) break;\n    }\n    fclose(x); fclose(y);\n    return same;\n}\n\nstatic int cmp_size(const void *a, const void *b) {\n    const FileRecord *x = *(FileRecord *const *)a, *y = *(FileRecord *const *)b;\n    return (x->size > y->size) - (x->size < y->size);\n}\nstatic int cmp_hash(const void *a, const void *b) {\n    const FileRecord *x = *(FileRecord *const *)a, *y = *(FileRecord *const *)b;\n    return (x->content_hash > y->content_hash) - (x->content_hash < y->content_hash);\n}\nstatic int cmp_path(const void *a, const void *b) {\n    return strcmp((*(FileRecord *const *)a)->path, (*(FileRecord *const *)b)->path);\n}\nstatic int cmp_group(const void *a, const void *b) {\n    const DupGroup *x = a, *y = b;\n    long long wx = x->size * (long long)(x->count - 1), wy = y->size * (long long)(y->count - 1);\n    return (wx < wy) - (wx > wy);                          /* biggest waste first */\n}\n\nstatic void add_group(const char *root, DupSet *ds, FileRecord **items, size_t n) {\n    FileRecord **m = xmalloc(n * sizeof *m);\n    size_t cnt = 0, i;\n    m[cnt++] = items[0];\n    for (i = 1; i < n; i++)\n        if (files_identical(root, items[0], items[i])) m[cnt++] = items[i];\n    if (cnt < 2) { free(m); return; }\n    qsort(m, cnt, sizeof *m, cmp_path);\n    ds->groups = realloc(ds->groups, (ds->count + 1) * sizeof *ds->groups);\n    if (!ds->groups) { fprintf(stderr, \"fatal: out of memory\\n\"); exit(1); }\n    ds->groups[ds->count].members = m;\n    ds->groups[ds->count].count = cnt;\n    ds->groups[ds->count].size = items[0]->size;\n    ds->count++;\n    ds->extra_files += cnt - 1;\n    ds->wasted += items[0]->size * (long long)(cnt - 1);\n}\n\nvoid dup_find(const char *root, const FileList *l, DupSet *ds) {\n    RecVec v;\n    const FileRecord *r;\n    size_t i = 0;\n    memset(ds, 0, sizeof *ds);\n    recvec_init(&v);\n    for (r = l->head; r; r = r->next)\n        if (!r->is_dir && r->size > 0) recvec_push(&v, (FileRecord *)r);\n    if (v.count > 1) qsort(v.items, v.count, sizeof *v.items, cmp_size);\n\n    while (i < v.count) {\n        size_t j = i + 1, k;\n        while (j < v.count && v.items[j]->size == v.items[i]->size) j++;\n        if (j - i >= 2) {                                  /* size collision only */\n            for (k = i; k < j; k++) ensure_hash(root, v.items[k]);\n            qsort(v.items + i, j - i, sizeof *v.items, cmp_hash);\n            k = i;\n            while (k < j) {\n                size_t b = k + 1;\n                while (b < j && v.items[b]->content_hash == v.items[k]->content_hash) b++;\n                if (b - k >= 2) add_group(root, ds, v.items + k, b - k);\n                k = b;\n            }\n        }\n        i = j;\n    }\n    if (ds->count > 1) qsort(ds->groups, ds->count, sizeof *ds->groups, cmp_group);\n    recvec_free(&v);\n}\n\nvoid dup_free(DupSet *d) {\n    size_t i;\n    for (i = 0; i < d->count; i++) free(d->groups[i].members);\n    free(d->groups);\n    memset(d, 0, sizeof *d);\n}\n"
  },
