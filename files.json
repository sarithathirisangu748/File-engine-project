    "modifiedAt": "2026-10-30T10:36:21.233Z",
    "content": "#ifndef QUEUE_H\n#define QUEUE_H\n#include \"common.h\"\n\n/* FIFO queue (linked). Used for BFS over the directory tree and graph. */\ntypedef struct QNode { void *data; struct QNode *next; } QNode;\ntypedef struct { QNode *head, *tail; size_t size; } Queue;\n\nvoid  q_init(Queue *q);\nvoid  q_push(Queue *q, void *data);\nvoid *q_pop(Queue *q);\nint   q_empty(const Queue *q);\nvoid  q_free(Queue *q);\n#endif\n"
  },
  {
    "id": "fse-project/fse/src/tree.c",
    "name": "tree.c",
    "path": "fse-project/fse/src/tree.c",
    "extension": ".c",
    "isFolder": false,
    "size": 4757,
    "modifiedAt": "2026-10-30T10:36:21.274Z",
    "content": "#include \"tree.h\"\n#include \"queue.h\"\n#include <ctype.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/stat.h>\n\nstatic TreeNode *node_new(FileRecord *r) {\n    TreeNode *n = xcalloc(1, sizeof *n);\n    n->rec = r;\n    return n;\n}\nstatic void attach(TreeNode *p, TreeNode *c) {\n    c->parent = p;\n    if (p->last_child) p->last_child->next_sibling = c; else p->first_child = c;\n    p->last_child = c;\n}\nstatic void set_ext(char *out, const char *name) {\n    const char *dot = strrchr(name, '.');\n    out[0] = '\\0';\n    if (dot && dot != name && dot[1]) {\n        size_t i;\n        for (i = 0; dot[1 + i] && i < EXT_LEN - 1; i++)\n            out[i] = (char)tolower((unsigned char)dot[1 + i]);\n        out[i] = '\\0';\n    }\n}\nstatic long long compute_sizes(TreeNode *n) {\n    if (n->rec->is_dir) {\n        long long sum = 0; TreeNode *c;\n        for (c = n->first_child; c; c = c->next_sibling) sum += compute_sizes(c);\n        n->rec->size = sum;\n    }\n    return n->rec->size;\n}\n\nTreeNode *tree_build(const char *root, FileList *list, int *max_depth) {\n    FileRecord *rr = xcalloc(1, sizeof *rr);\n    const char *b = strrchr(root, '/');\n    struct stat st;\n    TreeNode *rt;\n    Queue q;\n    int md = 0;\n\n    rr->id = -1; rr->is_dir = 1;\n    snprintf(rr->name, sizeof rr->name, \"%s\", (b && b[1]) ? b + 1 : root);\n    strcpy(rr->path, \".\");\n    if (stat(root, &st) == 0) rr->mtime = st.st_mtime;\n\n    rt = node_new(rr);\n    q_init(&q);\n    q_push(&q, rt);\n\n    while (!q_empty(&q)) {                       /* BFS over directories */\n        TreeNode *d = q_pop(&q);\n        char dfull[FULL_LEN];\n        char **names = NULL;\n        int n, i;\n\n        full_path(root, d->rec->path, dfull);\n        n = plat_list_dir(dfull, &names);\n        if (n < 0) continue;\n        for (i = 0; i < n; i++) {\n            const char *nm = names[i];\n            FileRecord t;\n            memset(&t, 0, sizeof t);\n            if (strcmp(nm, \".\") && strcmp(nm, \"..\") && strlen(nm) < NAME_LEN &&\n                path_join(t.path, sizeof t.path, d->rec->path, nm) == 0) {\n                char cfull[FULL_LEN];\n                struct stat cs;\n                full_path(root, t.path, cfull);\n                if (lstat(cfull, &cs) == 0 && (S_ISREG(cs.st_mode) || S_ISDIR(cs.st_mode))) {\n                    FileRecord *r; TreeNode *c;\n                    snprintf(t.name, sizeof t.name, \"%s\", nm);\n                    t.is_dir = S_ISDIR(cs.st_mode);\n                    t.size   = t.is_dir ? 0 : (long long)cs.st_size;\n                    t.mtime  = cs.st_mtime;\n                    t.depth  = d->rec->depth + 1;\n                    if (!t.is_dir) set_ext(t.ext, nm);\n                    r = fl_append(list, &t);\n                    c = node_new(r);\n                    attach(d, c);\n                    if (r->is_dir) q_push(&q, c);\n                    if (t.depth > md) md = t.depth;\n                }\n            }\n        }\n        plat_free_names(names, n);\n    }\n    q_free(&q);\n    compute_sizes(rt);\n    *max_depth = md;\n    return rt;\n}\n\nTreeNode *tree_find(TreeNode *root, const char *rel) {\n    char tmp[PATH_LEN], *p, *tok;\n    TreeNode *cur = root;\n    if (!rel || !strcmp(rel, \".\")) return root;\n    snprintf(tmp, sizeof tmp, \"%s\", rel);\n    p = tmp;\n    while (cur && (tok = path_next(&p)) != NULL) {\n        TreeNode *c = cur->first_child;\n        while (c && strcmp(c->rec->name, tok) != 0) c = c->next_sibling;\n        cur = c;\n    }\n    return cur;\n}\n\nstatic void print_children(const TreeNode *n, const char *prefix, int max_depth, int depth) {\n    const TreeNode *c;\n    for (c = n->first_child; c; c = c->next_sibling) {\n        int last = (c->next_sibling == NULL);\n        char sz[32];\n        human_size(c->rec->size, sz, sizeof sz);\n        printf(\"%s%s%s%s  (%s)\\n\", prefix, last ? TREE_LAST : TREE_MID,\n               c->rec->name, c->rec->is_dir ? \"/\" : \"\", sz);\n        if (c->rec->is_dir && depth < max_depth && strlen(prefix) + 8 < PATH_LEN) {\n            char np[PATH_LEN];\n            snprintf(np, sizeof np, \"%s%s\", prefix, last ? \"    \" : TREE_PIPE);\n            print_children(c, np, max_depth, depth + 1);\n        } else if (c->rec->is_dir && c->first_child) {\n            printf(\"%s%s...\\n\", prefix, last ? \"    \" : TREE_PIPE);\n        }\n    }\n}\n\nvoid tree_print(const TreeNode *n, int max_depth) {\n    char sz[32];\n    human_size(n->rec->size, sz, sizeof sz);\n    printf(\"%s/  (%s)\\n\", n->rec->name, sz);\n    print_children(n, \"\", max_depth, 1);\n}\n\nvoid tree_free(TreeNode *n) {\n    TreeNode *c;\n    if (!n) return;\n    c = n->first_child;\n    while (c) { TreeNode *nx = c->next_sibling; tree_free(c); c = nx; }\n    if (n->rec && n->rec->id == -1) free(n->rec);   /* root record is owned by the tree */\n    free(n);\n}\n"
  },
